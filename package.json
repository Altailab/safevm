{
  "name": "safevm",
  "private": true,
  "version": "0.0.1",
  "description": "Self-hosted secure streaming Linux workspaces with disposable file-detonation sandboxes",
  "author": "Rufat Mammadli (Altailab LLC)",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/Altailab/safevm",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:cp": "bun run --cwd packages/control-plane dev",
    "dev:agent": "bun run --cwd packages/node-agent dev",
    "dev:web": "bun run --cwd packages/web dev",
    "db:generate": "bun run --cwd packages/control-plane db:generate",
    "db:migrate": "bun run --cwd packages/control-plane db:migrate",
    "db:seed": "bun run --cwd packages/control-plane db:seed",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14"
  }
}
