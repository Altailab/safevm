# Copy to .env at the repo root (or export these) for local dev.
DATABASE_URL=postgres://safevm:safevm@localhost:5433/safevm
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://safevm:safevm@localhost:5672

JWT_SECRET=dev-only-change-me
TENANT_ID=default
WEB_ORIGIN=http://localhost:3000
PORT=3001

# node-agent: mock (Mac-local, no VM) | firecracker (Linux + KVM)
RUNTIME=mock

# Firecracker runtime (Linux host only) — see deploy/firecracker/README.md
NODE_ID=fc-node-1
FC_BIN=firecracker
FC_IMAGE_DIR=/srv/safevm/images
FC_RUN_DIR=/srv/safevm/run
FC_STREAM_PORT=6080
