# Hetzner Cloud provisioning — copy to deploy/hetzner/.env and fill in.
# Get a token: Hetzner Cloud Console → your project → Security → API Tokens (Read & Write).
HCLOUD_TOKEN=

# Server. cpx31 = 4 vCPU / 8 GB (AMD, nested-virt friendly for Firecracker).
# Use a ccx (dedicated vCPU) type for steadier microVM performance.
HCLOUD_SERVER_TYPE=cpx31
HCLOUD_LOCATION=nbg1            # nbg1/fsn1/hel1 (EU) · ash/hil (US)
HCLOUD_IMAGE=ubuntu-24.04
HCLOUD_SERVER_NAME=safevm-fc-test

# SSH keys used to reach the box (the public key is uploaded to Hetzner).
SSH_PUBLIC_KEY=~/.ssh/id_ed25519.pub
SSH_PRIVATE_KEY=~/.ssh/id_ed25519
